# SMS System Environment Variables
# Copy this file to .env and fill in your values

# Database (local Docker Postgres OR Supabase)
DB_USERNAME=smsuser
DB_PASSWORD=smspassword

# For Supabase - replace the SPRING_DATASOURCE_URL in docker-compose.yml with:
# jdbc:postgresql://db.<your-project>.supabase.co:5432/postgres
# And set DB_USERNAME=postgres, DB_PASSWORD=<your-supabase-password>

# JWT Secret (min 32 chars)
JWT_SECRET=mysecretkey123456789012345678901234567890
